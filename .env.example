# Optional OnCall SQL tool: use a separate database and restricted database user.
# Never reuse DATABASE_URL or an administrative PostgreSQL role.
ONCALL_DATABASE_URL=

# LLM Provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai

OPENAI_THINK_MODEL=deepseek-flash
OPENAI_THINK_API_KEY=
OPENAI_THINK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_QUICK_MODEL=deepseek-flash
OPENAI_QUICK_API_KEY=
OPENAI_QUICK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_THINK_MODEL=deepseek-flash
ANTHROPIC_THINK_API_KEY=
ANTHROPIC_THINK_BASE_URL=https://api.anthropic.com
ANTHROPIC_QUICK_MODEL=deepseek-flash
ANTHROPIC_QUICK_API_KEY=
ANTHROPIC_QUICK_BASE_URL=https://api.anthropic.com
ANTHROPIC_THINKING=true
ANTHROPIC_MAX_OUTPUT_TOKENS=8192

# embedding (OpenAI compatible, for RAG knowledge base)
# Used when EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
OPENAI_EMBEDDING_API_KEY=sk-xyz
OPENAI_EMBEDDING_BASE_URL=https://cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Embedding provider: "openai" (default) | "openai"
EMBEDDING_PROVIDER=openai

# Note: the vector index dimension is probed from the embedding provider at
# startup, so no dimension configuration is needed.

# Rerank (optional second-stage ranker for RAG retrieval — Aliyun DashScope
# text-rerank API, port of the legacy qwen3-vl-rerank pass). Empty
# RERANK_API_KEY disables rerank; retrieval then keeps the raw Milvus RRF
# fusion order.
RERANK_API_KEY=
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-vl-rerank
RERANK_TIMEOUT_MS=10000
RERANK_MAX_RETRIES=2

# Milvus (Vector Search — dense COSINE + native BM25 hybrid, requires Milvus Standalone 2.5+/3.x)
# See README.md → setup → Milvus for the standalone docker quickstart.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=yukino_knowledge
# BM25 analyzer: "standard" (default) or "chinese" (jieba, for mixed CN/EN corpora)
MILVUS_ANALYZER=standard

# PostgreSQL (Prisma) — relational database. docker compose up -d postgres
# Host port 5432 avoids clashing with a native PostgreSQL on 5432.
DATABASE_URL=postgresql://yukino:yukino@localhost:5432/yukino_agent
POSTGRES_USER=yukino
POSTGRES_PASSWORD=yukino
POSTGRES_DB=yukino_agent

# GitHub (DevFlow workspace). Token is optional for public repos (rate-limited);
# per-repo tokens can also be supplied in the UI and are encrypted at rest.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
# Shared secret for verifying inbound GitHub webhook signatures (HMAC-SHA256).
# Leave empty to skip verification (local dev only). POST /api/devflow/webhooks/github
GITHUB_WEBHOOK_SECRET=
# Key used to encrypt per-repo GitHub tokens at rest (AES-256-GCM). CHANGE IN PRODUCTION.
DEVFLOW_SECRET=devflow-local-dev-secret

# DevFlow periodic background re-sync of connected repositories (lib/devflow/scheduler.ts).
# Runs in-process from instrumentation.ts; disable on serverless/edge deployments.
DEVFLOW_AUTO_SYNC_ENABLED=false
DEVFLOW_AUTO_SYNC_INTERVAL_SECONDS=900
DEVFLOW_AUTO_SYNC_LIMIT=30

# DevFlow negative-feedback notification (Feishu/Lark incoming webhook). Empty = disabled.
DEVFLOW_FEISHU_WEBHOOK_URL=
# Public base URL used to build feedback trace links in notifications, e.g. https://app.example.com
DEVFLOW_FEEDBACK_TRACE_BASE_URL=

# DevFlow Category B: server-side managed git checkouts backing the workspace
# file tools (list/read/lexical search) and project-doc indexing. Clones are
# shallow (--depth 1) and stored on the Node server's disk. Requires `git` on PATH.
# Disable/avoid on serverless deployments (no persistent writable disk).
DEVFLOW_REPO_CHECKOUT_DIR=./data/workspaces
DEVFLOW_GIT_TIMEOUT_MS=180000
DEVFLOW_MAX_FILE_BYTES=300000
DEVFLOW_MAX_SCAN_FILES=2000

# MCP (Log tool SSE)
MCP_URL=http://localhost:3000/sse
# Optional bearer token for the built-in MCP log server.
MCP_TOKEN=

# Multi-source alert aggregation (legacy agent_py alert providers). JSON array of
# { "name": "prom-a", "type": "prometheus" | "alertmanager",
#   "baseUrl": "http://...", "username": "", "password": "" }.
# Empty = single source built from PROMETHEUS_BASE_URL. Same-name alerts are deduped.
ALERT_SOURCES=

# Admin gate for mutating OnCall operational surfaces (MCP connection CRUD,
# tool-call audit reads). Empty = mutations disabled (fail-closed).
ONCALL_ADMIN_TOKEN=

# Roll OnCall chat memory into an LLM summary instead of dropping evicted turns.
MEMORY_SUMMARY_ENABLED=true

# File upload directory (for knowledge base documents)
FILE_DIR=./data/docs

# Prometheus
PROMETHEUS_BASE_URL=http://127.0.0.1:9090

# Langfuse observability (optional; tracing is enabled only when all three are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
