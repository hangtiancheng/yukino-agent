// yukino-agent data model (PostgreSQL via Prisma driver adapter).
// Covers the DevFlow workspace: GitHub repositories and their synced
// issues / pull requests / CI runs, AI analysis results, the RAG knowledge
// document registry (vectors live in Milvus), and human-confirmed action drafts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Verified mailbox accounts are separate from DevFlow's demo permission user.
model MailboxAccount {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  authVersion    Int      @default(0)
  lastReminderAt DateTime?
  createdAt      DateTime @default(now())
  sessions       MailboxSession[]
  complaints     Complaint[]
}

model MailboxSession {
  tokenHash   String   @id
  accountId   String
  authVersion Int
  expiresAt   DateTime
  account     MailboxAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model MailboxCode {
  id         String   @id @default(uuid())
  email      String
  purpose    String
  digest     String
  attempts   Int      @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([email, purpose])
}

model MailboxThrottle {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Complaint {
  id          String   @id @default(uuid())
  authorId    String
  anonymous   Boolean  @default(false)
  subject     String
  body        String
  createdAt   DateTime @default(now())
  author      MailboxAccount @relation(fields: [authorId], references: [id])
  recipients  ComplaintRecipient[]

  @@index([authorId, createdAt])
}

model ComplaintRecipient {
  id          String    @id @default(uuid())
  complaintId String
  // Email identity intentionally supports recipients who have not registered.
  email       String
  readAt      DateTime?
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@unique([complaintId, email])
  @@index([email, readAt])
}

model Repository {
  id            String    @id @default(uuid())
  owner         String
  name          String
  fullName      String    @unique
  provider      String    @default("github")
  apiBaseUrl    String?
  description   String?
  defaultBranch String?
  githubId      BigInt?
  // AES-256-GCM encrypted personal access token (lib/devflow/crypto.ts).
  tokenEncrypted String?
  lastSyncAt     DateTime?
  lastSyncError  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  issues             Issue[]
  pullRequests       PullRequest[]
  workflowRuns       WorkflowRun[]
  knowledgeDocuments KnowledgeDocument[]
  actionDrafts       ActionDraft[]
  conversations      Conversation[]
  projectIndex       ProjectIndex?

  @@index([owner])
  @@index([name])
}

model Issue {
  id              String    @id @default(uuid())
  repoId          String
  githubIssueId   BigInt?
  number          Int
  title           String
  body            String?
  state           String    @default("open")
  labels          String[]
  author          String?
  assignees       String[]
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?
  githubClosedAt  DateTime?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, githubIssueId])
  @@index([repoId, number])
}

model PullRequest {
  id              String    @id @default(uuid())
  repoId          String
  githubPrId      BigInt?
  number          Int
  title           String
  body            String?
  state           String    @default("open")
  author          String?
  baseBranch      String?
  headBranch      String?
  additions       Int       @default(0)
  deletions       Int       @default(0)
  changedFiles    Int       @default(0)
  mergedAt        DateTime?
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?

  repo           Repository        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  files          PrFile[]
  reviewComments PrReviewComment[]

  @@unique([repoId, githubPrId])
  @@index([repoId, number])
}

model PrFile {
  id        String  @id @default(uuid())
  prId      String
  filename  String
  status    String  @default("modified")
  additions Int     @default(0)
  deletions Int     @default(0)
  patch     String?

  pr PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
}

model PrReviewComment {
  id              String    @id @default(uuid())
  prId            String
  githubCommentId BigInt?
  body            String?
  path            String?
  line            Int?
  author          String?
  githubCreatedAt DateTime?

  pr PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
}

model WorkflowRun {
  id              String    @id @default(uuid())
  repoId          String
  githubRunId     BigInt?
  name            String    @default("workflow")
  headBranch      String?
  status          String    @default("unknown")
  conclusion      String?
  htmlUrl         String?
  // Normalized job/step list: [{ id, name, status, conclusion, html_url, steps: [...] }]
  jobs            Json?
  logsText        String?
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, githubRunId])
  @@index([repoId])
}

model AnalysisResult {
  id           String   @id @default(uuid())
  // "issue" | "pull_request" | "workflow_run"
  targetType   String
  targetId     String
  // "issue_analysis" | "pr_review" | "ci_debug"
  analysisType String
  inputSnapshot Json?
  resultJson   Json
  modelName    String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model KnowledgeDocument {
  id         String   @id @default(uuid())
  repoId     String
  name       String
  // "upload" | "weekly_report" | "issue" | "pull_request"
  sourceType String   @default("upload")
  // "queued" | "indexing" | "ready" | "failed" | "skipped"
  status     String   @default("queued")
  contentHash String
  charCount  Int      @default(0)
  chunkCount Int      @default(0)
  errorMessage String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, contentHash])
  @@index([repoId])
}

model ActionDraft {
  id           String   @id @default(uuid())
  repoId       String
  // "issue_comment" | "create_issue" | "close_issue" | "add_labels"
  draftType    String
  // "issue" | "pull_request" | null
  targetType   String?
  targetNumber Int?
  title        String   @default("")
  content      String?
  labels       String[]
  // "low" | "medium" | "high"
  riskLevel    String   @default("medium")
  // "pending_confirmation" | "executed" | "rejected" | "failed"
  status       String   @default("pending_confirmation")
  executionResult Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, status])
  @@index([createdAt])
}

// --- Category C: conversations, chat feedback, permissions/audit ---
// Ported from the DevFlow-AI Python models (Conversation, ChatMessage,
// ChatFeedback, User, AuditLog). The B-only models those tables referenced
// (AgentRun / ChatSession / ConversationMemory / EvidenceItem / MemoryCandidate
// / RecallEvent / AgentWorkflowRun / AgentTaskRun) are intentionally absent, so
// feedback is anchored on the assistant ChatMessage id rather than a run id.

model User {
  id        String   @id @default(uuid())
  name      String
  // "owner" | "maintainer" | "developer" | "viewer"
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback  ChatFeedback[]
  auditLogs AuditLog[]
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  // Loose reference (no FK): an audit trail should survive repo deletion.
  repoId      String?
  action      String
  targetType  String?
  targetId    String?
  // "success" | "failed" | "denied"
  status      String   @default("success")
  requestJson Json?
  resultJson  Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repoId])
  @@index([action])
  @@index([createdAt])
}

model Conversation {
  id           String   @id @default(uuid())
  repoId       String
  title        String   @default("New conversation")
  // "active" | "deleted" (soft delete; messages/feedback are hard-deleted)
  status       String   @default("active")
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repo     Repository     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  feedback ChatFeedback[]

  @@index([repoId, status])
  @@index([updatedAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  // Denormalized for per-repo queries; cascade happens via the conversation.
  repoId         String
  // "user" | "assistant"
  role           String
  content        String
  // Normalized tool trace: [{ name, state, input? }]
  toolCalls      Json?
  meta           Json?
  createdAt      DateTime @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     ChatFeedback?

  @@index([conversationId, createdAt])
  @@index([repoId])
}

model ChatFeedback {
  id                 String    @id @default(uuid())
  repoId             String
  conversationId     String
  assistantMessageId String    @unique
  userId             String?
  // "helpful" | "unhelpful"
  rating             String
  // "inaccurate" | "not_relevant" | "missing_context" | "unreliable_citation" | "tool_error" | "other"
  reason             String?
  comment            String?
  // "open" | "in_review" | "resolved" | "dismissed"
  reviewStatus       String    @default("open")
  reviewNote         String?
  // "sent" | "failed" | "pending" | "not_configured" | "not_applicable"
  notificationStatus String    @default("not_applicable")
  notificationError  String?
  notifiedAt         DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assistantMessage ChatMessage  @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repoId])
  @@index([conversationId])
  @@index([reviewStatus])
}

// --- Category B: project-doc index state (vectors live in Milvus) ---
// One row per repository. The workspace manager clones/refreshes the repo to a
// managed checkout; project-indexing discovers the repo's docs/manifests,
// chunks + embeds them into the shared Milvus collection with
// source = "devflow:project:<repoId>". This row tracks status + fingerprint so
// re-indexing only happens when the checkout changed.
model ProjectIndex {
  id            String    @id @default(uuid())
  repoId        String    @unique
  // "idle" | "building" | "ready" | "failed"
  status        String    @default("idle")
  // Fingerprint of the indexed checkout (branch@commit) to detect staleness.
  fingerprint   String?
  branch        String?
  commitSha     String?
  fileCount     Int       @default(0)
  chunkCount    Int       @default(0)
  // Project summary: { techStack, topDirs, sourceTypeCoverage, docs }.
  summary       Json?
  errorMessage  String?
  snoozedUntil  DateTime?
  lastIndexedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([status])
}
