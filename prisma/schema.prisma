// yukino-agent data model (PostgreSQL via Prisma driver adapter).
// Covers the DevFlow workspace: GitHub repositories and their synced
// issues / pull requests / CI runs, AI analysis results, the RAG knowledge
// document registry (vectors live in Milvus), and human-confirmed action drafts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Repository {
  id            String    @id @default(uuid())
  owner         String
  name          String
  fullName      String    @unique
  provider      String    @default("github")
  apiBaseUrl    String?
  description   String?
  defaultBranch String?
  githubId      BigInt?
  // AES-256-GCM encrypted personal access token (lib/devflow/crypto.ts).
  tokenEncrypted String?
  lastSyncAt     DateTime?
  lastSyncError  String?
  // Managed-checkout overrides (local_path connect + clone_parent_dir).
  checkoutMode   String    @default("managed") // "managed" | "local"
  localPath      String?
  cloneParentDir String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  issues             Issue[]
  pullRequests       PullRequest[]
  workflowRuns       WorkflowRun[]
  knowledgeDocuments KnowledgeDocument[]
  actionDrafts       ActionDraft[]
  conversations      Conversation[]
  projectIndex       ProjectIndex?
  kbConfig           KnowledgeBaseConfig?
  retrievalTestRuns  RetrievalTestRun[]
  workflowRunRecords AgentWorkflowRun[]
  codeSymbols        CodeSymbol[]
  codeRelations      CodeRelation[]
  graphEdges         KnowledgeGraphEdge[]
  teamMembers        TeamMember[]
  threadMemory       ThreadMemory?
  conversationMemories ConversationMemory[]
  memoryCandidates   MemoryCandidate[]

  @@index([owner])
  @@index([name])
}

model Issue {
  id              String    @id @default(uuid())
  repoId          String
  githubIssueId   BigInt?
  number          Int
  title           String
  body            String?
  state           String    @default("open")
  labels          String[]
  author          String?
  assignees       String[]
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?
  githubClosedAt  DateTime?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, githubIssueId])
  @@index([repoId, number])
}

model PullRequest {
  id              String    @id @default(uuid())
  repoId          String
  githubPrId      BigInt?
  number          Int
  title           String
  body            String?
  state           String    @default("open")
  author          String?
  baseBranch      String?
  headBranch      String?
  additions       Int       @default(0)
  deletions       Int       @default(0)
  changedFiles    Int       @default(0)
  mergedAt        DateTime?
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?

  repo           Repository        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  files          PrFile[]
  reviewComments PrReviewComment[]

  @@unique([repoId, githubPrId])
  @@index([repoId, number])
}

model PrFile {
  id        String  @id @default(uuid())
  prId      String
  filename  String
  status    String  @default("modified")
  additions Int     @default(0)
  deletions Int     @default(0)
  patch     String?

  pr PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
}

model PrReviewComment {
  id              String    @id @default(uuid())
  prId            String
  githubCommentId BigInt?
  body            String?
  path            String?
  line            Int?
  // GitHub returns line=null with original_line set for outdated comments.
  originalLine    Int?
  author          String?
  githubCreatedAt DateTime?

  pr PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
}

model WorkflowRun {
  id              String    @id @default(uuid())
  repoId          String
  githubRunId     BigInt?
  name            String    @default("workflow")
  headBranch      String?
  status          String    @default("unknown")
  conclusion      String?
  htmlUrl         String?
  // Normalized job/step list: [{ id, name, status, conclusion, html_url, steps: [...] }]
  jobs            Json?
  logsText        String?
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, githubRunId])
  @@index([repoId])
}

model AnalysisResult {
  id           String   @id @default(uuid())
  // "issue" | "pull_request" | "workflow_run"
  targetType   String
  targetId     String
  // "issue_analysis" | "pr_review" | "ci_debug"
  analysisType String
  inputSnapshot Json?
  resultJson   Json
  modelName    String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model KnowledgeDocument {
  id         String   @id @default(uuid())
  repoId     String
  name       String
  // "upload" | "weekly_report" | "issue" | "pull_request" | "memory_note"
  sourceType String   @default("upload")
  // "queued" | "indexing" | "ready" | "failed" | "skipped"
  status     String   @default("queued")
  contentHash String
  charCount  Int      @default(0)
  chunkCount Int      @default(0)
  errorMessage String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  body KnowledgeDocumentBody?

  @@unique([repoId, contentHash])
  @@index([repoId])
}

// Raw text of a knowledge document, kept in a 1:1 side table so document
// listings never pull potentially-large bodies. Stored at upload so a failed
// index can be retried without re-uploading (legacy routes/rag.py
// documents/{document_id}/retry re-processed the stored file).
model KnowledgeDocumentBody {
  docId   String @id
  content String
  doc     KnowledgeDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
}

model ActionDraft {
  id           String   @id @default(uuid())
  repoId       String
  // "issue_comment" | "create_issue" | "close_issue" | "add_labels"
  draftType    String
  // "issue" | "pull_request" | null
  targetType   String?
  targetNumber Int?
  title        String   @default("")
  content      String?
  labels       String[]
  // "low" | "medium" | "high"
  riskLevel    String   @default("medium")
  // "pending_confirmation" | "executed" | "rejected" | "failed"
  status       String   @default("pending_confirmation")
  executionResult Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, status])
  @@index([createdAt])
}

// --- Category C: conversations, chat feedback, permissions/audit ---
// Ported from the DevFlow-AI Python models (Conversation, ChatMessage,
// ChatFeedback, User, AuditLog). The B-only models those tables referenced
// (AgentRun / ChatSession / ConversationMemory / EvidenceItem / MemoryCandidate
// / RecallEvent / AgentWorkflowRun / AgentTaskRun) are intentionally absent, so
// feedback is anchored on the assistant ChatMessage id rather than a run id.

model User {
  id        String   @id @default(uuid())
  name      String
  // "owner" | "maintainer" | "developer" | "viewer"
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback  ChatFeedback[]
  auditLogs AuditLog[]
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  // Loose reference (no FK): an audit trail should survive repo deletion.
  repoId      String?
  action      String
  targetType  String?
  targetId    String?
  // "success" | "failed" | "denied"
  status      String   @default("success")
  requestJson Json?
  resultJson  Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repoId])
  @@index([action])
  @@index([createdAt])
}

model Conversation {
  id           String   @id @default(uuid())
  repoId       String
  title        String   @default("New conversation")
  // "active" | "deleted" (soft delete; messages/feedback are hard-deleted)
  status       String   @default("active")
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repo     Repository     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  feedback ChatFeedback[]
  memory   ConversationMemory?

  @@index([repoId, status])
  @@index([updatedAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  // Denormalized for per-repo queries; cascade happens via the conversation.
  repoId         String
  // "user" | "assistant"
  role           String
  content        String
  // Normalized tool trace: [{ name, state, input? }]
  toolCalls      Json?
  meta           Json?
  createdAt      DateTime @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     ChatFeedback?

  @@index([conversationId, createdAt])
  @@index([repoId])
}

model ChatFeedback {
  id                 String    @id @default(uuid())
  repoId             String
  conversationId     String
  assistantMessageId String    @unique
  userId             String?
  // "helpful" | "unhelpful"
  rating             String
  // "inaccurate" | "not_relevant" | "missing_context" | "unreliable_citation" | "tool_error" | "other"
  reason             String?
  comment            String?
  // "open" | "in_review" | "resolved" | "dismissed"
  reviewStatus       String    @default("open")
  reviewNote         String?
  // "sent" | "failed" | "pending" | "not_configured" | "not_applicable"
  notificationStatus String    @default("not_applicable")
  notificationError  String?
  notifiedAt         DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assistantMessage ChatMessage  @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repoId])
  @@index([conversationId])
  @@index([reviewStatus])
}

// --- Category B: project-doc index state (vectors live in Milvus) ---
// One row per repository. The workspace manager clones/refreshes the repo to a
// managed checkout; project-indexing discovers the repo's docs/manifests,
// chunks + embeds them into the shared Milvus collection with
// source = "devflow:project:<repoId>". This row tracks status + fingerprint so
// re-indexing only happens when the checkout changed.
model ProjectIndex {
  id            String    @id @default(uuid())
  repoId        String    @unique
  // "idle" | "building" | "ready" | "failed"
  status        String    @default("idle")
  // Fingerprint of the indexed checkout (branch@commit) to detect staleness.
  fingerprint   String?
  branch        String?
  commitSha     String?
  fileCount     Int       @default(0)
  chunkCount    Int       @default(0)
  // Project summary: { techStack, topDirs, sourceTypeCoverage, docs }.
  summary       Json?
  errorMessage  String?
  snoozedUntil  DateTime?
  lastIndexedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([status])
}

// --- Migration-completeness restoration (2026-10-06 second pass) ---
// Models restoring capabilities that the Python legacy products had and the TS
// migration had recorded as scope cuts/degradations. Field semantics mirror
// the legacy SQLAlchemy models (.legacy/DevFlow-AI/backend/app/db/models.py,
// agent_py memory/extended_sqlite.py) adapted to this stack.

// Per-repo knowledge-base settings (legacy KnowledgeBaseConfig). Only the
// fields this architecture can honor are kept: absolute score thresholds
// depend on calibrated scores, which Milvus RRF ranks do not provide.
model KnowledgeBaseConfig {
  id              String   @id @default(uuid())
  repoId          String   @unique
  // "hybrid" (dense+BM25 RRF) | "dense" | "bm25"
  retrievalMethod String   @default("hybrid")
  rerankEnabled   Boolean  @default(true)
  topK            Int      @default(3)
  chunkSize       Int      @default(800)
  chunkOverlap    Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

// Persisted retrieval tests (legacy RAG studio retrieval-tests).
model RetrievalTestRun {
  id              String   @id @default(uuid())
  repoId          String
  query           String
  // Snapshot of the retrieval config used for this run.
  retrievalConfig Json     @default("{}")
  results         Json     @default("[]")
  durationMs      Int      @default(0)
  createdAt       DateTime @default(now())

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt])
}

// Administrator-configured MCP connections for OnCall (legacy
// mcp_connections multi-connection CRUD + :check). Single-tenant: the app is
// public with no login, so connections are global, not per-user.
model McpConnection {
  id              String    @id @default(uuid())
  name            String    @unique
  // "sse" | "http" (streamable HTTP)
  transport       String    @default("sse")
  url             String
  // Extra request headers (Authorization etc.) as a JSON object.
  headers         Json      @default("{}")
  enabled         Boolean   @default(true)
  // Last connectivity probe: "ok" | "error" | "never"
  lastCheckStatus String    @default("never")
  lastCheckMessage String?
  lastToolNames   Json      @default("[]")
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
}

// Multi-agent workflow runs (legacy AgentWorkflowRun/AgentTaskRun):
// planner -> observers -> synthesis with claim boundaries + acceptance.
model AgentWorkflowRun {
  id             String    @id @default(uuid())
  repoId         String?
  conversationId String?
  goal           String
  specJson       Json      @default("{}")
  observationJson Json     @default("{}")
  finalAnswer    String    @default("")
  metrics        Json      @default("{}")
  // "running" | "success" | "failed" | "cancelled"
  status         String    @default("running")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  repo  Repository?    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  tasks AgentTaskRun[]

  @@index([repoId, createdAt])
  @@index([status])
}

model AgentTaskRun {
  id          String    @id @default(uuid())
  workflowId  String
  taskId      String
  agentName   String
  taskType    String
  claimJson   Json      @default("{}")
  inputJson   Json      @default("{}")
  resultJson  Json      @default("{}")
  // "pending" | "running" | "success" | "failed" | "skipped"
  status      String    @default("pending")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?

  workflow AgentWorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([agentName])
}

// Code graph symbols/relations extracted from managed checkouts
// (legacy CodeSymbol/CodeRelation — regex extraction, snapshot-scoped rows).
model CodeSymbol {
  id        String   @id @default(uuid())
  repoId    String
  path      String
  name      String
  kind      String   @default("symbol")
  language  String   @default("text")
  startLine Int?
  endLine   Int?
  branch    String?
  commitSha String?
  // PR-snapshot scoping (null = default checkout scan)
  prNumber  Int?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, path])
  @@index([repoId, name])
  @@index([repoId, prNumber])
}

model CodeRelation {
  id         String   @id @default(uuid())
  repoId     String
  sourceName String?
  targetName String
  // "imports" | "calls" | "defines" | "references"
  type       String   @default("calls")
  path       String?
  branch     String?
  prNumber   Int?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, targetName])
  @@index([repoId, sourceName])
  @@index([repoId, prNumber])
}

// Knowledge graph edges across synced entities (legacy KnowledgeGraphEdge:
// 7 relation types + subgraph traversal).
model KnowledgeGraphEdge {
  id         String   @id @default(uuid())
  repoId     String
  fromType   String
  fromId     String
  toType     String
  toId       String
  // "references" | "resolves" | "documents" | "assigned_to" | "authored_by" |
  // "decides" (built by lib/devflow/knowledge-graph.ts)
  relation   String
  confidence Float    @default(1.0)
  source     String   @default("explicit")
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, fromType, fromId, toType, toId, relation])
  @@index([repoId, relation])
  @@index([fromType, fromId])
}

// Multi-repo groupings (legacy Workspace). repoIds is a loose reference list.
model Workspace {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  repoIds     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// Team-member profiles for suggested-owner validation
// (legacy team_member documents, structured here).
model TeamMember {
  id          String   @id @default(uuid())
  repoId      String
  githubLogin String
  displayName String?
  skills      String[]
  availability String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, githubLogin])
  @@index([repoId])
}

// Conversation-scoped structured memory (legacy ConversationMemory).
model ConversationMemory {
  id                  String   @id @default(uuid())
  repoId              String
  conversationId      String   @unique
  summary             String   @default("")
  facts               Json     @default("[]")
  decisions           Json     @default("[]")
  openQuestions       Json     @default("[]")
  tasks               Json     @default("[]")
  userPreferences     Json     @default("[]")
  repoContext         Json     @default("[]")
  citations           Json     @default("[]")
  sessionsIncorporated Int     @default(0)
  updatedAt           DateTime @updatedAt

  repo         Repository    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([repoId])
}

// Repository-thread memory merged from sealed conversations
// (legacy ThreadMemory).
model ThreadMemory {
  id                  String   @id @default(uuid())
  repoId              String   @unique
  summary             String   @default("")
  facts               Json     @default("[]")
  decisions           Json     @default("[]")
  openQuestions       Json     @default("[]")
  tasks               Json     @default("[]")
  userPreferences     Json     @default("[]")
  repoContext         Json     @default("[]")
  citations           Json     @default("[]")
  sessionsIncorporated Int     @default(0)
  updatedAt           DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

// Memory candidates proposed by agents, approved by humans into memory_note
// knowledge documents (legacy MemoryCandidate).
model MemoryCandidate {
  id             String    @id @default(uuid())
  repoId         String
  conversationId String?
  kind           String
  title          String
  content        String
  // "pending" | "approved" | "rejected"
  status         String    @default("pending")
  // "session_sealer" | "chat_agent" | "workflow"
  origin         String    @default("chat_agent")
  meta           Json      @default("{}")
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, status])
}

// OnCall AI Ops run history (legacy evidence-chain persistence, reduced to the
// synchronous single-row shape this deployment model supports: the full run
// with per-step detail is persisted once the graph finishes).
model AiOpsRun {
  id        String    @id @default(uuid())
  query     String
  // "running" | "success" | "exhausted" | "failed"
  status    String    @default("running")
  report    String    @default("")
  detail    Json      @default("[]")
  a2ui      Json?
  error     String?
  alertName String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([startedAt])
  @@index([alertName])
}

// Structured diagnostic-case registry backing the case-library API
// (legacy aiops_diagnostic_cases; the markdown itself lives in FILE_DIR and
// is indexed into Milvus by diagnostic-cases.ts).
model DiagnosticCaseRecord {
  id        String   @id @default(uuid())
  hash      String   @unique
  title     String
  alertName String   @default("")
  summary   String   @default("")
  keywords  String[]
  fileName  String
  createdAt DateTime @default(now())

  @@index([alertName])
  @@index([createdAt])
}

// OnCall agent tool-call audit trail (legacy agent_tool_call_audits).
model ToolCallAudit {
  id         String   @id @default(uuid())
  sessionId  String
  turnIndex  Int      @default(0)
  toolName   String
  source     String   @default("builtin") // "builtin" | "mcp"
  inputJson  Json     @default("{}")
  // Truncated result excerpt for review.
  resultText String   @default("")
  status     String   @default("success") // "success" | "error"
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([toolName])
}

// Chat prompt presets + SKILL.md assets for OnCall (legacy user_chat_assets /
// chat_skill_metadata, single-tenant here: administrator-managed, shared).
model ChatPrompt {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillAsset {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  // Progressive disclosure (legacy load_skill): only name+description ride in
  // the system prompt; the body is returned by the load_skill tool on demand.
  content     String
  meta        Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}
