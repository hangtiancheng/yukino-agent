
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Repository {
  id            String    @id @default(uuid())
  owner         String
  name          String
  fullName      String    @unique
  provider      String    @default("github")
  apiBaseUrl    String?
  description   String?
  defaultBranch String?
  githubId      BigInt?
  tokenEncrypted String?
  lastSyncAt     DateTime?
  lastSyncError  String?
  checkoutMode   String    @default("managed")
  localPath      String?
  cloneParentDir String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  issues             Issue[]
  pullRequests       PullRequest[]
  workflowRuns       WorkflowRun[]
  knowledgeDocuments KnowledgeDocument[]
  actionDrafts       ActionDraft[]
  conversations      Conversation[]
  projectIndex       ProjectIndex?
  kbConfig           KnowledgeBaseConfig?
  retrievalTestRuns  RetrievalTestRun[]
  workflowRunRecords AgentWorkflowRun[]
  codeSymbols        CodeSymbol[]
  codeRelations      CodeRelation[]
  graphEdges         KnowledgeGraphEdge[]
  teamMembers        TeamMember[]
  threadMemory       ThreadMemory?
  conversationMemories ConversationMemory[]
  memoryCandidates   MemoryCandidate[]

  @@index([owner])
  @@index([name])
}

model Issue {
  id              String    @id @default(uuid())
  repoId          String
  githubIssueId   BigInt?
  number          Int
  title           String
  body            String?
  state           String    @default("open")
  labels          String[]
  author          String?
  assignees       String[]
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?
  githubClosedAt  DateTime?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, githubIssueId])
  @@index([repoId, number])
}

model PullRequest {
  id              String    @id @default(uuid())
  repoId          String
  githubPrId      BigInt?
  number          Int
  title           String
  body            String?
  state           String    @default("open")
  author          String?
  baseBranch      String?
  headBranch      String?
  additions       Int       @default(0)
  deletions       Int       @default(0)
  changedFiles    Int       @default(0)
  mergedAt        DateTime?
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?

  repo           Repository        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  files          PrFile[]
  reviewComments PrReviewComment[]

  @@unique([repoId, githubPrId])
  @@index([repoId, number])
}

model PrFile {
  id        String  @id @default(uuid())
  prId      String
  filename  String
  status    String  @default("modified")
  additions Int     @default(0)
  deletions Int     @default(0)
  patch     String?

  pr PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
}

model PrReviewComment {
  id              String    @id @default(uuid())
  prId            String
  githubCommentId BigInt?
  body            String?
  path            String?
  line            Int?
  originalLine    Int?
  author          String?
  githubCreatedAt DateTime?

  pr PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
}

model WorkflowRun {
  id              String    @id @default(uuid())
  repoId          String
  githubRunId     BigInt?
  name            String    @default("workflow")
  headBranch      String?
  status          String    @default("unknown")
  conclusion      String?
  htmlUrl         String?
  jobs            Json?
  logsText        String?
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, githubRunId])
  @@index([repoId])
}

model AnalysisResult {
  id           String   @id @default(uuid())
  targetType   String
  targetId     String
  analysisType String
  inputSnapshot Json?
  resultJson   Json
  modelName    String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model KnowledgeDocument {
  id         String   @id @default(uuid())
  repoId     String
  name       String
  sourceType String   @default("upload")
  status     String   @default("queued")
  contentHash String
  charCount  Int      @default(0)
  chunkCount Int      @default(0)
  errorMessage String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  body KnowledgeDocumentBody?

  @@unique([repoId, contentHash])
  @@index([repoId])
}

model KnowledgeDocumentBody {
  docId   String @id
  content String
  doc     KnowledgeDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
}

model ActionDraft {
  id           String   @id @default(uuid())
  repoId       String
  draftType    String
  targetType   String?
  targetNumber Int?
  title        String   @default("")
  content      String?
  labels       String[]
  riskLevel    String   @default("medium")
  status       String   @default("pending_confirmation")
  executionResult Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, status])
  @@index([createdAt])
}


model User {
  id        String   @id @default(uuid())
  name      String
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback  ChatFeedback[]
  auditLogs AuditLog[]
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  repoId      String?
  action      String
  targetType  String?
  targetId    String?
  status      String   @default("success")
  requestJson Json?
  resultJson  Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repoId])
  @@index([action])
  @@index([createdAt])
}

model Conversation {
  id           String   @id @default(uuid())
  repoId       String
  title        String   @default("New conversation")
  status       String   @default("active")
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repo     Repository     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  feedback ChatFeedback[]
  memory   ConversationMemory?

  @@index([repoId, status])
  @@index([updatedAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  repoId         String
  role           String
  content        String
  toolCalls      Json?
  meta           Json?
  createdAt      DateTime @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     ChatFeedback?

  @@index([conversationId, createdAt])
  @@index([repoId])
}

model ChatFeedback {
  id                 String    @id @default(uuid())
  repoId             String
  conversationId     String
  assistantMessageId String    @unique
  userId             String?
  rating             String
  reason             String?
  comment            String?
  reviewStatus       String    @default("open")
  reviewNote         String?
  notificationStatus String    @default("not_applicable")
  notificationError  String?
  notifiedAt         DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assistantMessage ChatMessage  @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repoId])
  @@index([conversationId])
  @@index([reviewStatus])
}

model ProjectIndex {
  id            String    @id @default(uuid())
  repoId        String    @unique
  status        String    @default("idle")
  fingerprint   String?
  branch        String?
  commitSha     String?
  fileCount     Int       @default(0)
  chunkCount    Int       @default(0)
  summary       Json?
  errorMessage  String?
  snoozedUntil  DateTime?
  lastIndexedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([status])
}


model KnowledgeBaseConfig {
  id              String   @id @default(uuid())
  repoId          String   @unique
  retrievalMethod String   @default("hybrid")
  rerankEnabled   Boolean  @default(true)
  topK            Int      @default(3)
  chunkSize       Int      @default(800)
  chunkOverlap    Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model RetrievalTestRun {
  id              String   @id @default(uuid())
  repoId          String
  query           String
  retrievalConfig Json     @default("{}")
  results         Json     @default("[]")
  durationMs      Int      @default(0)
  createdAt       DateTime @default(now())

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt])
}

model McpConnection {
  id              String    @id @default(uuid())
  name            String    @unique
  transport       String    @default("sse")
  url             String
  headers         Json      @default("{}")
  enabled         Boolean   @default(true)
  lastCheckStatus String    @default("never")
  lastCheckMessage String?
  lastToolNames   Json      @default("[]")
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
}

model AgentWorkflowRun {
  id             String    @id @default(uuid())
  repoId         String?
  conversationId String?
  goal           String
  specJson       Json      @default("{}")
  observationJson Json     @default("{}")
  finalAnswer    String    @default("")
  metrics        Json      @default("{}")
  status         String    @default("running")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  repo  Repository?    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  tasks AgentTaskRun[]

  @@index([repoId, createdAt])
  @@index([status])
}

model AgentTaskRun {
  id          String    @id @default(uuid())
  workflowId  String
  taskId      String
  agentName   String
  taskType    String
  claimJson   Json      @default("{}")
  inputJson   Json      @default("{}")
  resultJson  Json      @default("{}")
  status      String    @default("pending")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?

  workflow AgentWorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([agentName])
}

model CodeSymbol {
  id        String   @id @default(uuid())
  repoId    String
  path      String
  name      String
  kind      String   @default("symbol")
  language  String   @default("text")
  startLine Int?
  endLine   Int?
  branch    String?
  commitSha String?
  prNumber  Int?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, path])
  @@index([repoId, name])
  @@index([repoId, prNumber])
}

model CodeRelation {
  id         String   @id @default(uuid())
  repoId     String
  sourceName String?
  targetName String
  type       String   @default("calls")
  path       String?
  branch     String?
  prNumber   Int?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, targetName])
  @@index([repoId, sourceName])
  @@index([repoId, prNumber])
}

model KnowledgeGraphEdge {
  id         String   @id @default(uuid())
  repoId     String
  fromType   String
  fromId     String
  toType     String
  toId       String
  relation   String
  confidence Float    @default(1.0)
  source     String   @default("explicit")
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, fromType, fromId, toType, toId, relation])
  @@index([repoId, relation])
  @@index([fromType, fromId])
}

model Workspace {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  repoIds     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model TeamMember {
  id          String   @id @default(uuid())
  repoId      String
  githubLogin String
  displayName String?
  skills      String[]
  availability String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, githubLogin])
  @@index([repoId])
}

model ConversationMemory {
  id                  String   @id @default(uuid())
  repoId              String
  conversationId      String   @unique
  summary             String   @default("")
  facts               Json     @default("[]")
  decisions           Json     @default("[]")
  openQuestions       Json     @default("[]")
  tasks               Json     @default("[]")
  userPreferences     Json     @default("[]")
  repoContext         Json     @default("[]")
  citations           Json     @default("[]")
  sessionsIncorporated Int     @default(0)
  updatedAt           DateTime @updatedAt

  repo         Repository    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([repoId])
}

model ThreadMemory {
  id                  String   @id @default(uuid())
  repoId              String   @unique
  summary             String   @default("")
  facts               Json     @default("[]")
  decisions           Json     @default("[]")
  openQuestions       Json     @default("[]")
  tasks               Json     @default("[]")
  userPreferences     Json     @default("[]")
  repoContext         Json     @default("[]")
  citations           Json     @default("[]")
  sessionsIncorporated Int     @default(0)
  updatedAt           DateTime @updatedAt

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model MemoryCandidate {
  id             String    @id @default(uuid())
  repoId         String
  conversationId String?
  kind           String
  title          String
  content        String
  status         String    @default("pending")
  origin         String    @default("chat_agent")
  meta           Json      @default("{}")
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, status])
}

model AiOpsRun {
  id        String    @id @default(uuid())
  query     String
  status    String    @default("running")
  report    String    @default("")
  detail    Json      @default("[]")
  a2ui      Json?
  error     String?
  alertName String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([startedAt])
  @@index([alertName])
}

model DiagnosticCaseRecord {
  id        String   @id @default(uuid())
  hash      String   @unique
  title     String
  alertName String   @default("")
  summary   String   @default("")
  keywords  String[]
  fileName  String
  createdAt DateTime @default(now())

  @@index([alertName])
  @@index([createdAt])
}

model ToolCallAudit {
  id         String   @id @default(uuid())
  sessionId  String
  turnIndex  Int      @default(0)
  toolName   String
  source     String   @default("builtin")
  inputJson  Json     @default("{}")
  resultText String   @default("")
  status     String   @default("success")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([toolName])
}

model ChatPrompt {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillAsset {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  content     String
  meta        Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}
